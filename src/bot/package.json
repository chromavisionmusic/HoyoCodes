{
  "name": "bot",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch ./index.ts",
    "deploy": "bun ./deploy.ts",
    "build": "bun build ./index.ts --compile --minify --sourcemap --bytecode --outfile ../../bin/bot",
    "build:linux": "bun build ./index.ts --compile --minify --target=bun-linux-x64 --outfile ../../bin/bot-linux-x64",
    "build:macos": "bun build ./index.ts --compile --minify --target=bun-darwin-arm64 --outfile ../../bin/bot-macos-arm64",
    "build:windows": "bun build ./index.ts --compile --minify --target=bun-windows-x64 --outfile ../../bin/bot-windows-x64",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "latest"
  },
  "dependencies": {
    "discord.js": "^14.27.0"
  }
}
